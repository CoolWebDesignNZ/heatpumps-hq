---
// FAQs are plain visible text: no accordions.
// split: heading on the left, questions stacked on the right (installation page).
interface Props { items: { q: string; a: string }[]; heading?: string; intro?: string; split?: boolean }
const { items, heading = 'Heat pump questions', intro, split = false } = Astro.props;
---
<section class="section warm">
  <div class:list={["wrap", { "faq-split": split }]}>
    <div class="faq-head"><h2>{heading}</h2>
    {intro && <p class="lead">{intro}</p>}</div>
    <div class:list={["faq-grid", { "faq-stack": split }]}>
      {items.map((f) => (<div class="faq-item"><h3>{f.q}</h3><p set:html={f.a} /></div>))}
    </div>
  </div>
</section>
<style>
  .faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 32px; }
  .faq-item { background: #fff; border-radius: var(--radius); padding: 28px 30px; box-shadow: var(--shadow); }
  .faq-item p { margin: 0; color: var(--ink-soft); }
  .faq-split { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 56px; align-items: start; }
  .faq-split .faq-head { position: sticky; top: 110px; }
  .faq-stack { grid-template-columns: 1fr; margin-top: 0; gap: 16px; }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } .faq-split { grid-template-columns: 1fr; gap: 24px; } .faq-split .faq-head { position: static; } }
</style>

---
// steps: the two-step version (home page). Step 2 only shows once Name and Phone are filled in.
interface Props { suburb?: string; steps?: boolean }
const { suburb = '', steps = false } = Astro.props;
const options = ['Installation', 'Repair', 'Service'];
---
{steps ? (
<form class="qf qf-steps" method="post" action="/api/quote" data-step="1">
  <h2 class="qf-h">Get a free quote</h2>
  <div class="qf-step" data-step="1">
    <div class="row">
      <label>Name<input name="name" required autocomplete="name" /></label>
      <label>Phone<input name="phone" type="tel" required autocomplete="tel" /></label>
    </div>
    <fieldset>
      <legend>What do you need?</legend>
      <div class="opts">
        {options.map((o, i) => (
          <label class="opt"><input type="radio" name="service" value={o} checked={i === 0} /><span>{o}</span></label>
        ))}
      </div>
    </fieldset>
    <label>Type a brief description below<textarea name="message" rows="2" placeholder="Area you want to heat, fault description..."></textarea></label>
    <button class="btn btn-primary qf-next" type="button">Next step</button>
  </div>
  <div class="qf-step" data-step="2">
    <label>Suburb<input name="suburb" required autocomplete="address-level2" placeholder="e.g., Riccarton, Rolleston" value={suburb} /></label>
    <label>Email <span class="opt-note">(optional)</span><input name="email" type="email" autocomplete="email" /></label>
    <button class="btn btn-primary" type="submit">Request my quote</button>
    <button class="qf-back" type="button">Back</button>
  </div>
  <p class="qf-note">No obligation. We'll call or email you back.</p>
</form>
) : (
<form class="qf" method="post" action="/api/quote">
  <h2 class="qf-h">Get a free quote</h2>
  <input type="hidden" name="suburb" value={suburb} />
  <div class="row">
    <label>Name<input name="name" required autocomplete="name" /></label>
    <label>Phone<input name="phone" type="tel" required autocomplete="tel" /></label>
  </div>
  <label>Email <span class="opt-note">(optional)</span><input name="email" type="email" autocomplete="email" /></label>
  <label>Street address<input name="address" autocomplete="street-address" placeholder="Helps the installer and saves time" /></label>
  <fieldset>
    <legend>What do you need?</legend>
    <div class="opts">
      {['Installation', 'Repair', 'Service'].map((o, i) => (
        <label class="opt"><input type="radio" name="service" value={o} checked={i === 0} /><span>{o}</span></label>
      ))}
    </div>
  </fieldset>
  <label>Type a brief description below<textarea name="message" rows="2" placeholder="Area you want to heat, fault description..."></textarea></label>
  <button class="btn btn-primary" type="submit">Request my quote</button>
  <p class="qf-note">No obligation. We'll call or email you back.</p>
</form>
)}
<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('.qf-steps')) {
    const show = (n: string) => { form.dataset.step = n; form.querySelector<HTMLElement>(`.qf-step[data-step="${n}"] input`)?.focus(); };
    form.classList.add('js');
    form.querySelector('.qf-next')?.addEventListener('click', () => {
      const first = [...form.querySelectorAll<HTMLInputElement>('.qf-step[data-step="1"] input[required]')];
      if (first.every((i) => i.reportValidity())) show('2');
    });
    form.querySelector('.qf-back')?.addEventListener('click', () => show('1'));
  }
</script>
<style>
  .qf { background: #fff; border-radius: 12px; box-shadow: 0 20px 50px rgba(0, 0, 0, .22); padding: 20px 20px 16px; color: var(--ink); max-width: 460px; }
  .qf-h { font-size: 1.25rem; margin: 0 0 .5em; }
  .qf label { display: block; font-weight: 600; font-size: .85rem; margin-top: 10px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .row label { margin-top: 0; }
  .qf input:not([type=radio]), .qf textarea { display: block; width: 100%; margin-top: 4px; padding: 9px 11px; font: inherit; font-size: 16px; font-weight: 400; border: 1px solid #c9ced4; border-radius: 6px; background: #fff; }
  .qf input::placeholder, .qf textarea::placeholder { color: #8a929b; }
  .qf input:focus, .qf textarea:focus { outline: 2px solid var(--brand); outline-offset: -1px; border-color: transparent; }
  fieldset { border: 0; padding: 0; margin: 10px 0 0; }
  legend { font-weight: 600; font-size: .85rem; padding: 0; }
  .opts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 4px; }
  .qf .opt { margin: 0; }
  .opt input { position: absolute; opacity: 0; }
  .opt span { display: block; text-align: center; padding: 7px 4px; border: 1px solid #c9ced4; border-radius: 6px; font-weight: 500; font-size: .9rem; cursor: pointer; }
  .opt input:checked + span { background: var(--brand); border-color: var(--brand); color: #fff; }
  .opt input:focus-visible + span { outline: 2px solid var(--brand-ink); }
  .opt-note { font-weight: 400; color: var(--ink-soft); }
  .qf button { width: 100%; margin-top: 14px; padding: 12px; border: 0; border-radius: 6px; font-size: 1rem; cursor: pointer; }
  .qf-steps { padding: 18px 18px 14px; }
  .qf-steps .qf-h { font-size: 1.15rem; margin-bottom: .3em; }
  .qf-steps label, .qf-steps fieldset { margin-top: 8px; }
  .qf-steps textarea { min-height: 0; }
  .qf-steps .qf-next { margin-top: 12px; padding: 12px !important; }
  .qf-steps.js[data-step="1"] .qf-step[data-step="2"], .qf-steps.js[data-step="2"] .qf-step[data-step="1"] { display: none; }
  .qf-steps:not(.js) .qf-next, .qf-steps:not(.js) .qf-back { display: none; }
  .qf-next { font-weight: 700; font-size: 1.05rem !important; padding: 14px !important; }
  .qf .qf-back { display: block; width: auto; margin: 10px auto 0; padding: 4px 8px; background: none; color: var(--link); font-size: .9rem; text-decoration: underline; }
  .qf-note { font-size: .8rem; color: var(--ink-soft); margin: 10px 0 0; }
</style>

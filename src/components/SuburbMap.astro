---
// Full-width map of every suburb and town we cover. Each dot links to that
// suburb's page; colours follow the area groups on the locations page.
// Positions in src/data/suburb-map.json came from OpenStreetMap (Nominatim).
import points from '../data/suburb-map.json';
interface Props { heading?: string; lead?: string }
const { heading = 'Map of the suburbs we cover', lead } = Astro.props;
const areaNames = [...new Set(points.map((p) => p.area))];
const colours = ['#0a6fb8', '#d9822b', '#2f9e6e', '#8a5cc2', '#c94a6a', '#0b2a40'];
const short = (a) => { const t = a.replace(/^heat pumps?( [a-z ]+?)? (in|for|on) (the )?/i, ''); return t[0].toUpperCase() + t.slice(1); };
const legend = areaNames.map((a, i) => ({ name: short(a), colour: colours[i % colours.length] }));
const data = points.map((p) => ({ ...p, colour: colours[areaNames.indexOf(p.area) % colours.length] }));
---
<section class="map-section">
  <div class="wrap">
    <h2>{heading}</h2>
    {lead && <p class="lead">{lead}</p>}
    <ul class="map-legend">{legend.map((l) => <li><span style={`background:${l.colour}`}></span>{l.name}</li>)}</ul>
  </div>
  <div id="suburb-map" class="suburb-map" data-points={JSON.stringify(data)} role="region" aria-label="Map of suburbs we cover. Each suburb is also listed above as a link."></div>
</section>
<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  const el = document.getElementById('suburb-map');
  if (el) {
    const pts = JSON.parse(el.dataset.points || '[]');
    const map = L.map(el, { scrollWheelZoom: false, zoomSnap: 0.25 });
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 16, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);
    const group = L.featureGroup();
    for (const p of pts) {
      const m = L.circleMarker([p.lat, p.lng], { radius: 8, color: '#fff', weight: 2, fillColor: p.colour, fillOpacity: 0.95 });
      m.bindTooltip(p.name, { direction: 'top', offset: [0, -6] });
      m.on('click', () => { window.location.href = p.href; });
      m.addTo(group);
    }
    group.addTo(map);
    map.fitBounds(group.getBounds(), { padding: [24, 24] });
  }
</script>
<style>
  .map-section { padding: 72px 0 0; }
  .map-legend { list-style: none; padding: 0; margin: 8px 0 24px; display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: .95rem; }
  .map-legend li { display: flex; align-items: center; gap: 8px; }
  .map-legend span { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }
  .suburb-map { width: 100%; height: 560px; background: #e8eef2; }
  .suburb-map :global(.leaflet-interactive) { cursor: pointer; }
  @media (max-width: 640px) { .suburb-map { height: 440px; } }
</style>

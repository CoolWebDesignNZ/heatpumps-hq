---
// Full-bleed photo hero with the quote form on the right, used on every page.
import Img from './Img.astro';
import QuoteForm from './QuoteForm.astro';
import site from '../data/site.json';
// home: the home page hero (brand line above the call line, narrower form column).
interface Props { image: string; h1: string; intro: string; suburb?: string; meta?: string; home?: boolean }
const { image, h1, intro, suburb = '', meta, home = false } = Astro.props;
const brands = [['Mitsubishi Electric', '/mitsubishi-heat-pump-service-christchurch/'], ['Daikin', '/daikin-heat-pump-service-christchurch/'], ['Fujitsu', '/fujitsu-heat-pump-service-christchurch/'], ['Toshiba', '/toshiba-heat-pump-service-christchurch/']];
---
<section class:list={["hero", { "hero-home": home }]}>
  <Img id={image} eager class="hero-bg" />
  <div class="hero-shade"></div>
  <div class="wrap hero-in">
    <div class="hero-copy">
      <slot name="crumbs" />
      <h1>{h1}</h1>
      <p class="hero-lead">{intro}</p>
      {meta && <p class="hero-meta">{meta}</p>}
      {home && <p class="hero-brands">We install {brands.map(([n, href], i) => <>{i > 0 && (i === brands.length - 1 ? ' and ' : ', ')}<a href={href}>{n}</a></>)}.</p>}
      <p class:list={["hero-talk", { "hero-talk-first": !home }]}>Prefer to talk? <a href={site.phoneHref}>Call {site.phone}</a></p>
    </div>
    <div id="quote" class="hero-form"><QuoteForm suburb={suburb} /></div>
  </div>
</section>
<section class="trust">
  <div class="wrap trust-in">
    <div><strong>{Math.floor((new Date().getFullYear() - site.founded) / 5) * 5}+</strong><span>years in business</span></div>
    <div><strong>Certified</strong><span>trained team</span></div>
    <div><strong>All brands</strong><span>serviced and repaired</span></div>
    <div><strong>Insured</strong><span>fully covered</span></div>
  </div>
</section>
<style>
  .hero { position: relative; isolation: isolate; color: #fff; }
  .hero :global(.hero-bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 0; aspect-ratio: auto !important; z-index: -2; }
  .hero-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(12, 22, 34, .82) 0%, rgba(12, 22, 34, .62) 48%, rgba(12, 22, 34, .18) 100%); }
  .hero-in { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 440px); gap: 64px; align-items: center; padding-top: 88px; padding-bottom: 88px; min-height: 640px; }
  .hero h1 { color: #fff; font-size: clamp(2.4rem, 5vw, 4rem); }
  .hero-lead { font-size: 1.25rem; color: rgba(255, 255, 255, .9); margin-bottom: 1.6em; }
  .hero.hero-home h1 { font-size: clamp(2rem, 4.1vw, 2.82rem); text-wrap: balance; }
  @media (min-width: 961px) { .hero-home .hero-in { grid-template-columns: minmax(0, 1fr) minmax(0, 380px); gap: 48px; } }
  .hero-home .hero-shade { background: linear-gradient(0deg, rgba(12, 22, 34, .6) 0%, rgba(12, 22, 34, 0) 50%), linear-gradient(90deg, rgba(12, 22, 34, .88) 0%, rgba(12, 22, 34, .66) 48%, rgba(12, 22, 34, .18) 100%); }
  .hero-talk-first { margin-top: 0 !important; }
  .hero-talk { margin: 44px 0 20px; font-size: 1rem; color: rgba(255, 255, 255, .78); }
  .hero-talk a { color: #fff; font-weight: 650; text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .hero-talk a:hover { text-decoration-color: #fff; }
  @media (max-width: 640px) { .hero-talk { font-size: 16px; } }
  .hero-brands { margin-top: 1.2em; font-size: .95rem; color: rgba(255, 255, 255, .8); }
  .hero-brands a { color: #fff; font-weight: 700; text-decoration: none; }
  .hero-brands a:hover { text-decoration: underline; }
  .hero-meta { margin-top: 1.4em; color: rgba(255, 255, 255, .8); }
  .hero :global(.crumbs-hero) { margin-bottom: 1.2em; color: rgba(255, 255, 255, .8); }
  .hero :global(.crumbs-hero a) { color: rgba(255, 255, 255, .8); }
  .hero-form { color: var(--ink); }
  .trust { background: #fff; box-shadow: 0 1px 0 rgba(0, 0, 0, .06); }
  .trust-in { display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; }
  .trust-in > div { padding: 26px 12px; display: flex; flex-direction: column; gap: 2px; }
  .trust-in > div + div { border-left: 1px solid #e6e9ec; }
  .trust-in strong { font-size: 1.6rem; font-weight: 800; color: var(--brand); letter-spacing: -0.02em; line-height: 1.15; }
  .trust-in span { font-size: .95rem; color: var(--ink-soft); }
  @media (max-width: 960px) {
    .hero-in { grid-template-columns: 1fr; gap: 40px; padding-top: 56px; padding-bottom: 56px; min-height: 0; }
    .hero-shade { background: rgba(12, 22, 34, .7); }
    .trust-in { grid-template-columns: 1fr 1fr; }
    .trust-in > div { padding: 18px 8px; }
    .trust-in > div:nth-child(3) { border-left: 0; }
    .trust-in > div:nth-child(n+3) { border-top: 1px solid #e6e9ec; }
    .trust-in strong { font-size: 1.3rem; }
  }
</style>

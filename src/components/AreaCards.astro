---
// Suburbs grouped by area, read from the locations page (its ## headings and
// suburb links), shown as cards. Used on the home and installation pages.
import locationsMd from '../content/locations.md?raw';
const areas = [];
for (const line of locationsMd.split('\n')) {
  const h = line.match(/^## (.+)/);
  if (h) { const t = h[1].replace(/^heat pumps?( [a-z ]+?)? (in|for|on) (the )?/i, ''); areas.push({ title: t[0].toUpperCase() + t.slice(1), links: [] }); continue; }
  const l = line.match(/^- \[([^\]]+)\]\((\/[^)]+)\)/);
  if (l && areas.length) areas.at(-1).links.push({ name: l[1], href: l[2] });
}
const groups = areas.filter((a) => a.links.length);
const total = groups.reduce((n, g) => n + g.links.length, 0);
---
<div class="area-grid">
  {groups.map((g) => (
    <div class="area-card">
      <h3>{g.title}</h3>
      <p class="area-count">{g.links.length} {g.title === 'Selwyn' ? 'towns' : 'suburbs'}</p>
      <ul>{g.links.map((s) => <li><a href={s.href}>{s.name}</a></li>)}</ul>
    </div>
  ))}
</div>
<p class="more"><a href="/locations/">See all {total} suburbs and towns we cover</a></p>
<style>
  .area-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 8px; }
  @media (max-width: 980px) { .area-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .area-grid { grid-template-columns: 1fr; } }
  .area-card { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow); padding: 24px 26px; }
  .area-card h3 { margin: 0 0 2px; }
  .area-count { color: var(--ink-soft); font-size: .9rem; margin: 0 0 14px; }
  .area-card ul { list-style: none; padding: 0; margin: 0; columns: 2; column-gap: 16px; }
  .area-card li { break-inside: avoid; font-size: .95rem; line-height: 1.7; }
</style>

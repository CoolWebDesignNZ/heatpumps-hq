---
// The Heat Pumps HQ logo as inline SVG, redrawn from the supplied PNG with the
// correct name: a house outline wrapping the name, the floor line running into
// CHRISTCHURCH, which ends under "HQ". Drawn in currentColor (dark in the
// header, white in the footer).
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class={cls} viewBox="0 0 304 96" role="img" aria-label="Heat Pumps HQ Christchurch" xmlns="http://www.w3.org/2000/svg">
  <path d="M84 27 L52 5 L10 40 Q8 42.5 11.5 42.5 H24 V80 Q24 86 30 86 H147" fill="none" stroke="currentColor" stroke-width="5.6" stroke-linecap="round" stroke-linejoin="round" />
  <text x="35" y="67" fill="currentColor" font-family="Inter Variable, Inter, system-ui, sans-serif" font-weight="660" font-size="36" letter-spacing="-0.9">Heat Pumps HQ</text>
  <text x="299" y="91" text-anchor="end" fill="currentColor" font-family="Inter Variable, Inter, system-ui, sans-serif" font-weight="650" font-size="13.5" letter-spacing="3.1">CHRISTCHURCH</text>
</svg>

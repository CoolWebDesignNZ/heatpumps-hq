---
// Main navigation: short drop-downs for Services and Guides (the `menu` list
// in src/data/nav.json), then plain links. Every other page is reached from
// the hub pages. The full section lists in nav.json drive the breadcrumbs.
import site from '../data/site.json';
import nav from '../data/nav.json';
import Logo from './Logo.astro';

const menus = nav.menu;
const plain = site.nav.filter((n) => !menus.some((m) => m.label === n.label));
const here = Astro.url.pathname;
---
<header class="hdr">
  <div class="wrap hdr-in">
    <a href="/" class="logo"><Logo /></a>
    <nav class="main" aria-label="Main">
      <ul>
        {menus.map((m) => (
          <li class="has-menu">
            <a href={m.href} class="top" aria-haspopup="true">{m.label}</a>
            <ul class="menu">
              {m.links.map(([label, href]) => <li><a href={href} aria-current={href === here ? 'page' : undefined}>{label}</a></li>)}
              {m.all && <li class="all"><a href={m.href}>{m.all}</a></li>}
            </ul>
          </li>
        ))}
        {plain.map((n) => <li><a href={n.href} class="top">{n.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn-primary call" href={site.phoneHref}><span class="call-short">Call</span><span class="call-long">{site.phone}</span></a>
    <details class="mnav">
      <summary>Menu</summary>
      <div class="mnav-panel">
        <a class="mtop" href="/">Home</a>
        {menus.map((m) => (
          <details class="msec">
            <summary><a class="mtop" href={m.href}>{m.label}</a><span class="mtoggle">Show</span></summary>
            <ul>
              {m.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
              {m.all && <li class="all"><a href={m.href}>{m.all}</a></li>}
            </ul>
          </details>
        ))}
        {plain.map((n) => <a class="mtop" href={n.href}>{n.label}</a>)}
      </div>
    </details>
  </div>
</header>
<style>
  .hdr { background: #fff; position: sticky; top: 0; z-index: 10; box-shadow: 0 1px 0 rgba(0,0,0,.06); }
  .hdr-in { display: flex; align-items: stretch; gap: 32px; min-height: 76px; }
  .logo { align-self: center; display: block; line-height: 0; color: var(--brand-ink); }
  .logo :global(svg) { height: 54px; width: auto; }
  .main { margin-left: auto; display: flex; }
  .main > ul { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
  .main > ul > li { display: flex; align-items: center; position: relative; }
  .top { color: var(--ink); text-decoration: none; font-weight: 550; }
  .top:hover, .has-menu:hover .top, .has-menu:focus-within .top { color: var(--brand); }
  .call { align-self: center; padding: 12px 22px; white-space: nowrap; }

  .menu { display: none; position: absolute; top: 100%; left: -18px; min-width: 250px; list-style: none; margin: 0; padding: 10px 0; background: #fff; border-radius: 10px; box-shadow: 0 14px 34px rgba(16, 24, 32, .14); }
  .has-menu:hover .menu, .has-menu:focus-within .menu { display: block; }
  .menu a { display: block; padding: 8px 18px; color: var(--ink); text-decoration: none; font-size: 1rem; }
  .menu a:hover, .menu a[aria-current] { color: var(--brand); background: var(--brand-tint); }
  .menu .all { margin-top: 6px; padding-top: 6px; border-top: 1px solid #eee; }
  .menu .all a { color: var(--brand); font-weight: 650; }

  .mnav { display: none; align-self: center; }
  .mnav > summary { list-style: none; cursor: pointer; font-weight: 650; padding: 10px 16px; border-radius: 999px; background: var(--paper-warm); }
  .mnav > summary::-webkit-details-marker { display: none; }
  .mnav-panel { position: absolute; left: 0; right: 0; top: 100%; background: #fff; box-shadow: 0 18px 40px rgba(16, 24, 32, .12); padding: 8px 24px 20px; max-height: calc(100vh - 76px); overflow-y: auto; }
  .mnav ul { list-style: none; margin: 0; padding: 0 0 12px; }
  .mnav li { margin: 0 0 10px; }
  .mnav a { color: var(--ink); text-decoration: none; }
  .mnav .all a { color: var(--brand); font-weight: 650; }
  .msec > summary { list-style: none; display: flex; align-items: center; justify-content: space-between; cursor: pointer; }
  .msec > summary::-webkit-details-marker { display: none; }
  .mtoggle { font-size: .9rem; font-weight: 600; color: var(--brand); padding: 6px 12px; border-radius: 999px; background: var(--brand-tint); }
  .msec[open] .mtoggle { color: #fff; background: var(--brand); }
  .mtop { display: block; font-weight: 650; padding: 12px 0; color: var(--ink); }
  .mnav-panel > .mtop, .msec { border-bottom: 1px solid #eee; }

  @media (max-width: 980px) { .main { display: none; } .mnav { display: block; } .call { margin-left: auto; } }
  .call-short { display: none; }
  @media (max-width: 560px) { .hdr-in { gap: 12px; } .logo :global(svg) { height: 42px; } .call { padding: 10px 16px; } .call-long { display: none; } .call-short { display: inline; } }
</style>

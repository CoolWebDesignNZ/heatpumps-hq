---
// Key facts about the business, built from site.json so they read the same on
// every page. Shown as plain text for readers and for search and AI tools.
// place: the suburb or town on location pages; the full service area otherwise.
// price: only on pages CLAUDE.md lists for the from-price.
import site from '../data/site.json';
interface Props { place?: string; inSelwyn?: boolean; price?: boolean }
const { place, inSelwyn = false, price = false } = Astro.props;
const list = (a: string[]) => a.slice(0, -1).join(', ') + ' and ' + a.at(-1);
const facts = [
  ['Area', place ? `${place}, ${inSelwyn ? 'Selwyn District' : 'Christchurch'}` : site.area],
  ['What we do', 'Heat pump installation, servicing and repair'],
  ['Brands we fit', list(site.brandsInstalled)],
  ['Brands we repair', `All major brands, including ${list(site.brandsServiced)}`],
  ...(price ? [['Installations', `From ${site.installFrom}`]] : []),
  ['Quotes', 'Free'],
  ['Hours', `${site.hours[0].days}, ${site.hours[0].label}`],
  ['Phone', site.phone],
  ['Business', `${site.name}, started in ${site.founded} by ${site.owner}`],
  ['Qualification', `${site.owner} holds the ${site.ownerCredential}`],
];
---
<section class="section facts-band">
  <div class="wrap">
    <h2>{place ? `Heat Pumps HQ in ${place}: key facts` : 'Heat Pumps HQ: key facts'}</h2>
    <dl class="facts">
      {facts.map(([k, v]) => (
        <div><dt>{k}</dt><dd>{k === 'Phone' ? <a href={site.phoneHref}>{v}</a> : v}</dd></div>
      ))}
    </dl>
  </div>
</section>
<style>
  .facts-band { padding: 64px 0; }
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 48px; margin: 0; }
  .facts div { display: grid; grid-template-columns: 9.5em 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid #e3e6e9; }
  .facts dt { font-weight: 700; }
  .facts dd { margin: 0; color: var(--ink-soft); }
  @media (max-width: 860px) { .facts { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .facts div { grid-template-columns: 1fr; gap: 2px; } }
</style>

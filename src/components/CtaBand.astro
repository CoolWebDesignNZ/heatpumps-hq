---
import site from '../data/site.json';
// dark: the home page's closing band (client, 2026-10-27): call as an outline button, call back scrolls to the hero form.
interface Props { heading?: string; dark?: boolean }
const { heading = 'Get a free heat pump quote', dark = false } = Astro.props;
---
<section class:list={["section", dark ? "cta-dark" : "tint"]}>
  <div class="wrap cta">
    <h2>{heading}</h2>
    <p class="lead">Free quotes. Monday to Friday, 8am to 5pm. No obligation. We'll call or email you back.</p>
    {dark ? (
      <>
        <a class="btn btn-outline" href={site.phoneHref}>Call {site.phone}</a>
        <a class="btn btn-primary" href="#quote">Request a call back</a>
      </>
    ) : (
      <>
        <a class="btn btn-primary" href={site.phoneHref}>Call {site.phone}</a>
        <a class="btn btn-ghost" href="/contact-us/">Request a call back</a>
      </>
    )}
  </div>
</section>
<style>
  .cta { text-align: center; }
  .cta .lead { margin: 0 auto 1.6em; }
  .cta .btn { margin: 6px; }
  .cta-dark { background: #0c1622; color: #fff; }
  .cta-dark h2 { color: #fff; }
  .cta-dark .lead { color: rgba(255, 255, 255, .8); }
  .btn-outline { background: transparent; color: #fff; box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .7); }
  .btn-outline:hover { background: rgba(255, 255, 255, .1); }
</style>

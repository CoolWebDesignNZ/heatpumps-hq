---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
interface Props { title: string; description: string; schema?: object[]; image?: string }
const { title, description, schema = [], image } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.domain).href;
const business = {
  '@context': 'https://schema.org',
  '@type': 'HVACBusiness',
  '@id': `${site.domain}/#business`,
  name: site.name,
  url: `${site.domain}/`,
  telephone: '+64 3 242 1023',
  email: site.email,
  founder: { '@type': 'Person', name: site.owner },
  foundingDate: String(site.founded),
  areaServed: ['Christchurch', 'Selwyn District', 'Lyttelton'],
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: site.hours[0].open, closes: site.hours[0].close,
  }],
  sameAs: [site.facebook],
};
const graph = [business, ...schema];
---
<!doctype html>
<html lang="en-NZ">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {image && <meta property="og:image" content={new URL(`/images/${image}.jpg`, site.domain).href} />}
  <meta property="og:locale" content="en_NZ" />
  <link rel="sitemap" href="/sitemap_index.xml" />
  {graph.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
</head>
<body>
  <Header />
  <main><slot /></main>
  <Footer />
</body>
</html>

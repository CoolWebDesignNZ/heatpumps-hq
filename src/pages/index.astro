---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Hero from '../components/Hero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import site from '../data/site.json';



// Six main service cards (client, 2026-10-27), then the other services as a text list.
const services = [
  { img: 'home-install', h: 'Heat pump installation', href: '/heat-pump-installation-in-christchurch/', a: 'Get an installation quote',
    p: 'We size from your rooms, insulation, glazing and orientation. Wall, floor console and high-wall units, installed tidy.' },
  { img: 'home-ducted', h: 'Ducted heat pumps', href: '/ducted-heat-pumps-christchurch/', a: 'See ducted systems',
    p: 'We plan and fit ducted systems with a vent in every room and nothing on the walls. Best planned early in a build or renovation.' },
  { img: 'multi-hero', h: 'Multi-room heat pumps', href: '/multi-room-heat-pump-installation/', a: 'See multi-room options',
    p: 'Several indoor units on one outdoor unit, so each room you use has its own heat and its own controller.' },
  { img: 'home-service', h: 'Heat pump servicing', href: '/heat-pump-servicing/', a: 'Book a service',
    p: 'We clean and check your heat pump once a year, so it runs cheaper and quieter and smells fresh. Before winter is best.' },
  { img: 'home-repair', h: 'Heat pump repairs', href: '/heat-pump-repair/', a: 'Book a repair',
    p: 'Not heating, leaking or showing an error code? We find the fault on any major brand and tell you if it\'s worth repairing.' },
  { img: 'aircon-hero', h: 'Air conditioning', href: '/air-conditioning-installation-christchurch/', a: 'See air conditioning',
    p: 'We install heat pumps that cool as well as heat, so one unit keeps the house comfortable on hot nor\'west days.' },
];

// Brand row: what we do with each brand and its service page.
const brandRow = [
  ['Mitsubishi Electric', '/mitsubishi-heat-pump-service-christchurch/', true],
  ['Daikin', '/daikin-heat-pump-service-christchurch/', true],
  ['Fujitsu', '/fujitsu-heat-pump-service-christchurch/', true],
  ['Toshiba', '/toshiba-heat-pump-service-christchurch/', true],
  ['Panasonic', '/panasonic-heat-pump-service-christchurch/', false],
];

const otherServices = [['High-wall heat pumps', '/high-wall-heat-pumps/'], ['Floor-mounted heat pumps', '/floor-mounted-heat-pumps/'], ['Single room heat pumps', '/single-room-heat-pump-installation/'], ['Emergency repairs', '/emergency-heat-pump-repair/'], ['Heat pump cleaning', '/heat-pump-cleaning/'], ['Heat pump covers', '/covers/'], ['Maintenance plans', '/customised-heat-pump-service-plans/']];

const guides = [
  { img: 'boundary-hero', h: 'Heat pump boundary rules & consent', href: '/heat-pump-boundary-rules-consent-nz/', p: 'The noise limits, when you need consent, and where the outdoor unit can go in Christchurch.', a: 'Read the boundary rules guide' },
  { img: 'noise-hero', h: 'Noise problems & fixes', href: '/heat-pump-noise-problems-solutions/', p: 'Why a heat pump gets loud, what the council rules actually say, and the repairs that quieten it.', a: 'Read the noise guide' },
  { img: 'sizing-hero', h: 'What size heat pump do I need?', href: '/heat-pump-sizing/', p: 'How to work out the kW a room needs, so you don\'t pay for a unit that\'s too big.', a: 'Use the sizing guide' },
];

const steps = [
  ['You tell us the room and the problem.', 'Size, ceiling height, how the space is used, or just "it\'s not heating."'],
  ['We ask about insulation, glazing and orientation.', 'These decide the kW far more than floor area alone.'],
  ['We recommend a size and a unit.', 'Sometimes that\'s a smaller unit than you expected. Sometimes it\'s a repair, not a new one.'],
  ['You get a written quote before any work starts.', 'Free, no obligation.'],
];

const areas = [['Rolleston', '/rolleston/'], ['Lincoln', '/lincoln/'], ['Halswell', '/halswell/'], ['Riccarton', '/heat-pumps-riccarton/'], ['Papanui', '/heat-pumps-papanui/'], ['Cashmere', '/cashmere/'], ['Sumner', '/sumner/'], ['Lyttelton', '/lyttelton/']];

const faqs = [
  { q: 'Which heat pump brands do you install?', a: 'Mitsubishi Electric, Daikin, Fujitsu and Toshiba. We service and repair those and Panasonic, and most other brands sold in New Zealand.' },
  { q: 'What areas do you cover?', a: 'All of Christchurch, and Lyttelton. Plus Selwyn towns like Rolleston, Lincoln and Prebbleton. See the <a href="/locations/">full list of locations</a>.' },
  { q: 'Do I need consent for a heat pump?', a: 'Usually not. Christchurch doesn\'t set a distance from the boundary. The District Plan controls the noise at the neighbour\'s property instead. Our <a href="/heat-pump-boundary-rules-consent-nz/">boundary rules guide</a> has the limits.' },
  { q: 'How do you decide what size unit I need?', a: 'We look at the rooms, ceiling height, insulation, glazing and orientation, not just floor area. A well-insulated room sometimes needs a smaller unit than expected. Our <a href="/heat-pump-sizing/">sizing guide</a> explains the method.' },
  { q: 'Do you charge for a quote?', a: 'No. The quote is free and there\'s no obligation. We\'ll look at the room and recommend a size and unit before any work starts.' },
  { q: 'How often should a heat pump be serviced?', a: 'Once a year for most homes. Before winter is best. In between, clean the filters yourself every few weeks while it\'s working hard.' },
];
---
<Base
  title="Heat Pumps Christchurch: Installation, Service & Repair"
  description="Heat pump installation, servicing and repairs across Christchurch, Selwyn and Lyttelton. Sized to your home, not the biggest unit we can sell. Free quote."
  image="home-hero"
  schema={[{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })) }]}>

  <Hero image="home-hero" home h1="Heat pumps in Christchurch: sized to your home, not the biggest unit we can sell."
        intro={`We fit, service and repair heat pumps across Christchurch, Selwyn and Lyttelton. Locally owned since ${site.founded}. Free quote. We look at your rooms, insulation and windows before we recommend a unit.`} />

  <section class="section">
    <div class="wrap">
      <h2>Heat pump guides for Christchurch homes</h2>
      <p class="lead">The rules, the noise limits, and the sizing maths that actually apply to Canterbury homes.</p>
      <div class="grid three">
        {guides.map((g) => <a class="card" href={g.href}><Img id={g.img} class="card-img" /><div class="card-body"><h3>{g.h}</h3><p>{g.p}</p><p class="card-go">{g.a} →</p></div></a>)}
      </div>
      <p class="more"><a href="/heat-pump-guides/">See all heat pump guides</a></p>
    </div>
  </section>

  <section class="section warm">
    <div class="wrap center">
      <h2>A free quote that starts with your house, not a unit.</h2>
      <p class="lead">We don't guess the size from a photo. Here is what happens when you request a quote.</p>
      <ol class="steps">
        {steps.map(([h, p], i) => <li><span class="step-n">{i + 1}</span><h3>{h}</h3><p>{p}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Heat pump services</h2>
      <p class="lead">From a single high-wall unit in a bedroom to a ducted system for the whole house.</p>
      <div class="grid three svc">
        {services.map((s) => (
          <a class="card" href={s.href}>
            <Img id={s.img} class="card-img" />
            <div class="card-body">
              <h3>{s.h}</h3>
              <p>{s.p}</p>
              <p class="card-go">{s.a} →</p>
            </div>
          </a>
        ))}
      </div>
      <div class="other">
        <h3>Other services:</h3>
        <p>{otherServices.map(([n, href], i) => <>{i > 0 && ' · '}<a href={href}>{n}</a></>)}</p>
      </div>
    </div>
  </section>

  <section class="section warm">
    <div class="wrap">
      <h2>Heat pump brands we install and repair</h2>
      <p class="lead">We fit Mitsubishi Electric, Daikin, Fujitsu and Toshiba. We service and repair those and Panasonic, and most other brands sold in New Zealand.</p>
      <div class="brand-row">
        {brandRow.map(([name, href, fit]) => (
          <a class="brand-tile" href={href}>
            <span class="brand-tag">{fit ? 'Install, service and repair' : 'Service and repair'}</span>
            <strong>{name}</strong>
            <span class="brand-go">{name === 'Mitsubishi Electric' ? 'Mitsubishi' : name} heat pump service →</span>
          </a>
        ))}
        <a class="brand-tile" href="/heat-pump-repair/">
          <span class="brand-tag">Service and repair</span>
          <strong>Other brands</strong>
          <span class="brand-note">Most others sold in New Zealand</span>
          <span class="brand-go">Repairs on other brands →</span>
        </a>
      </div>
      <p class="more"><a href="/heat-pump-brands-comparison/">See how the brands compare</a></p>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <h2>Heat pumps across Christchurch, Selwyn and Lyttelton</h2>
      <p class="lead">From the frosty mornings out on the plains to the dense streets of the inner city, we know how different homes handle the Canterbury climate.</p>
      <p>We work in every Christchurch suburb, plus Lyttelton and the Selwyn towns of Rolleston, Lincoln, Prebbleton and Tai Tapu.</p>
      <p class="areas"><strong>Popular areas:</strong> {areas.map(([n, href], i) => <>{i > 0 && ' · '}<a href={href}>{n}</a></>)}</p>
      <p class="more"><a href="/locations/">See all locations</a></p>
    </div>
  </section>

  <Faq items={faqs} heading="Common questions about heat pumps in Christchurch" intro="Straight answers to the things people ask us most before they book a quote." />
  <CtaBand heading="Get a free heat pump quote in Christchurch" dark />
</Base>
<style>
  .three { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 980px) { .three { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .three { grid-template-columns: 1fr; } }
  .three :global(.card-img) { border-radius: var(--radius) var(--radius) 0 0; width: 100%; aspect-ratio: 16/9 !important; object-fit: cover; display: block; }
  .card h3 a { color: var(--ink); text-decoration: none; }
  .card h3 a:hover { color: var(--brand); }
  .areas a { font-weight: 600; }
  .card-go { margin-top: 12px; font-weight: 600; color: var(--link); }
  .card-go a { color: var(--link); text-decoration: none; }
  .card-go a:hover { text-decoration: underline; }
  .center { text-align: center; }
  .center .lead { margin-left: auto; margin-right: auto; }
  .steps { list-style: none; padding: 0; margin: 40px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; text-align: left; }
  .steps li { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow); padding: 28px 24px; }
  .steps h3 { font-size: 1.1rem; margin: 14px 0 .5em; }
  .steps p { margin: 0; color: var(--ink-soft); }
  .step-n { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--brand); color: #fff; font-weight: 750; }
  @media (max-width: 980px) { .steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .steps { grid-template-columns: 1fr; } }
  .brand-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 28px; }
  .brand-tile { display: flex; flex-direction: column; gap: 6px; background: #fff; border-radius: var(--radius); box-shadow: var(--shadow); padding: 20px 20px 18px; color: var(--ink); text-decoration: none; }
  .brand-tile:hover { box-shadow: 0 1px 2px rgba(16, 24, 32, .08), 0 12px 28px rgba(16, 24, 32, .12); }
  .brand-tile strong { font-size: 1.2rem; line-height: 1.2; }
  .brand-note { font-size: .85rem; line-height: 1.35; color: var(--ink-soft); }
  .brand-tag { font-size: .78rem; font-weight: 700; color: var(--brand-ink); }
  .brand-go { margin-top: auto; padding-top: 8px; font-size: .9rem; font-weight: 650; color: var(--link); }
  .brand-tile:hover .brand-go { text-decoration: underline; }
  @media (max-width: 600px) { .brand-row { grid-template-columns: 1fr 1fr; gap: 12px; } .brand-tile { padding: 16px; } .brand-tile strong { font-size: 1.05rem; } }
  .other { margin-top: 40px; }
  .other h3 { margin-bottom: .4em; }
  .other a { font-weight: 600; }
</style>

---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Hero from '../components/Hero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import site from '../data/site.json';
import urls from '../data/urls.json';
const serviceCount = urls.filter((u) => u.type === 'service').length;



// Five service cards, each with what we check before quoting (client, 2026-10-27).
const services = [
  { img: 'home-install', h: 'Heat pump installation', href: '/heat-pump-installation-in-christchurch/', a: 'Heat pump installation in Christchurch',
    p: 'We size from your rooms, insulation, glazing and orientation. Wall, floor console and high-wall units, installed tidy.',
    checkLabel: 'What we check before quoting', check: ['room size', 'ceiling height', 'insulation', 'glazing', 'orientation', 'outdoor unit placement'] },
  { img: 'home-ducted', h: 'Ducted heat pumps', href: '/ducted-heat-pumps-christchurch/', a: 'Ducted heat pump installation Christchurch',
    p: 'We plan and fit ducted systems with a vent in every room and nothing on the walls. Best planned early in a build or renovation.',
    checkLabel: 'What we check', check: ['room layout', 'ceiling/roof access', 'zoning needs', 'duct runs', 'outdoor unit siting'] },
  { img: 'multi-hero', h: 'Multi-room heat pumps', href: '/multi-room-heat-pump-installation/', a: 'Multi-room heat pump installation',
    p: 'Several indoor units on one outdoor unit, so each room you use has its own heat and its own controller.',
    checkLabel: 'What we check', check: ['how many rooms run at once', 'whether a multi-split or ducted suits better', 'outdoor unit capacity'] },
  { img: 'home-service', h: 'Heat pump servicing', href: '/heat-pump-servicing/', a: 'Heat pump servicing Christchurch',
    p: 'We clean and check your heat pump once a year, so it runs cheaper and quieter and smells fresh. Before winter is best.',
    checkLabel: 'What an annual service covers', check: ['coil clean', 'filter deep-clean', 'drain flush', 'electrical check', 'refrigerant pressure test'] },
  { img: 'home-repair', h: 'Heat pump repairs', href: '/heat-pump-repair/', a: 'Heat pump repair Christchurch',
    p: 'Not heating, leaking or showing an error code? We find the fault on any major brand and tell you if it\'s worth repairing.',
    checkLabel: 'What we check', check: ['fault codes', 'refrigerant pressure', 'electrical draw', 'airflow', 'drainage', 'outdoor unit condition'] },
];

const guides = [
  { img: 'boundary-hero', h: 'Heat pump boundary rules & consent', href: '/heat-pump-boundary-rules-consent-nz/', p: 'The noise limits, when you need consent, and where the outdoor unit can go in Christchurch.', a: 'Read the boundary rules guide' },
  { img: 'noise-hero', h: 'Noise problems & fixes', href: '/heat-pump-noise-problems-solutions/', p: 'Why a heat pump gets loud, what the council rules actually say, and the repairs that quieten it.', a: 'Read the noise guide' },
  { img: 'sizing-hero', h: 'What size heat pump do I need?', href: '/heat-pump-sizing/', p: 'How to work out the kW a room needs, so you don\'t pay for a unit that\'s too big.', a: 'Use the sizing guide' },
];

const steps = [
  ['You tell us the room and the problem.', 'Size, ceiling height, how the space is used, or just "it\'s not heating."'],
  ['We ask about insulation, glazing and orientation.', 'These decide the kW far more than floor area alone.'],
  ['We recommend a size and a unit.', 'Sometimes that\'s a smaller unit than you expected. Sometimes it\'s a repair, not a new one.'],
  ['You get a written quote before any work starts.', 'Free, no obligation.'],
];

const areas = [['Rolleston', '/rolleston/'], ['Lincoln', '/lincoln/'], ['Halswell', '/halswell/'], ['Riccarton', '/heat-pumps-riccarton/'], ['Papanui', '/heat-pumps-papanui/'], ['Cashmere', '/cashmere/'], ['Sumner', '/sumner/'], ['Lyttelton', '/lyttelton/']];

const faqs = [
  { q: 'Which heat pump brands do you install?', a: 'Mitsubishi Electric, Daikin, Fujitsu and Toshiba. We service and repair those and Panasonic, and most other brands sold in New Zealand.' },
  { q: 'What areas do you cover?', a: 'All of Christchurch, and Lyttelton. Plus Selwyn towns like Rolleston, Lincoln and Prebbleton. See the <a href="/locations/">full list of locations</a>.' },
  { q: 'Do I need consent for a heat pump?', a: 'Usually not. Christchurch doesn\'t set a distance from the boundary. The District Plan controls the noise at the neighbour\'s property instead. Our <a href="/heat-pump-boundary-rules-consent-nz/">boundary rules guide</a> has the limits.' },
  { q: 'How do you decide what size unit I need?', a: 'We look at the rooms, ceiling height, insulation, glazing and orientation, not just floor area. A well-insulated room sometimes needs a smaller unit than expected. Our <a href="/heat-pump-sizing/">sizing guide</a> explains the method.' },
  { q: 'Do you charge for a quote?', a: 'No. The quote is free and there\'s no obligation. We\'ll look at the room and recommend a size and unit before any work starts.' },
  { q: 'How often should a heat pump be serviced?', a: 'Once a year for most homes. Before winter is best. In between, clean the filters yourself every few weeks while it\'s working hard.' },
];
---
<Base
  title="Heat Pumps Christchurch: Installation, Service & Repair"
  description="Heat pump installation, servicing and repairs across Christchurch, Selwyn and Lyttelton. Sized to your home, not the biggest unit we can sell. Free quote."
  image="home-hero"
  schema={[{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })) }]}>

  <Hero image="home-hero" home h1="Heat pumps in Christchurch: sized to your home, not the biggest unit we can sell."
        h1Lines={["Heat pumps in Christchurch: sized to your home,", "not the biggest unit we can sell."]}
        intro={`We fit, service and repair heat pumps across Christchurch, Selwyn and Lyttelton. Locally owned since ${site.founded}. Free quote. We look at your rooms, insulation and windows before we recommend a unit.`} />

  <section class="section">
    <div class="wrap">
      <h2>Heat pump guides for Christchurch homes</h2>
      <div class="grid three">
        {guides.map((g) => <a class="card" href={g.href}><Img id={g.img} class="card-img" /><div class="card-body"><h3>{g.h}</h3><p>{g.p}</p><p class="card-go">{g.a} →</p></div></a>)}
      </div>
      <p class="more"><a href="/heat-pump-guides/">See all heat pump guides</a></p>
    </div>
  </section>

  <section class="section warm">
    <div class="wrap">
      <h2>A free quote that starts with your house, not a unit.</h2>
      <ol class="steps">
        {steps.map(([h, p]) => <li><strong>{h}</strong> {p}</li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Heat pump installation, servicing and repairs</h2>
      <p class="lead">From one bedroom unit to a ducted system for the whole house. We fit it, service it and repair it, anywhere in Christchurch.</p>
      <div class="grid three svc">
        {services.map((s) => (
          <article class="card">
            <a href={s.href} tabindex="-1" aria-hidden="true"><Img id={s.img} class="card-img" /></a>
            <div class="card-body">
              <h3><a href={s.href}>{s.h}</a></h3>
              <p>{s.p}</p>
              <p class="card-check"><strong>{s.checkLabel}:</strong> {s.check.join(' · ')}.</p>
              <p class="card-go"><a href={s.href}>{s.a} →</a></p>
            </div>
          </article>
        ))}
      </div>
      <p class="more"><a href="/heat-pump-services/">See all {serviceCount} heat pump services</a></p>
    </div>
  </section>

  <section class="section warm">
    <div class="wrap brand-split">
      <div>
        <h2>Why Christchurch homes choose Heat Pumps HQ</h2>
        <p>Heat Pumps HQ is a Christchurch company, started here by Nate Thompson in {site.founded}. We've been fitting, servicing and repairing heat pumps in local homes for over 10 years.</p>
        <ul class="brand-list">
          <li><strong>Sized to your house.</strong> We recommend the unit your rooms need, not the biggest one we can sell.</li>
          <li><strong>A free quote first.</strong> You get a quote before any work starts, and it costs nothing.</li>
          <li><strong>Trained and certified technicians.</strong> A licensed electrical worker makes the connection on every install.</li>
          <li><strong>Fully insured.</strong> Every install comes with warranties on parts and labour.</li>
          <li><strong>The brands that suit Canterbury.</strong> We fit Mitsubishi Electric, Daikin, Fujitsu and Toshiba, and service those and Panasonic.</li>
        </ul>
        <p class="more"><a href="/about-us/">More about Heat Pumps HQ</a></p>
      </div>
      <Img id="installers-hero" class="brand-photo" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="prose">
        <h2>Heat pumps sized for your home, not the biggest unit</h2>
        <p>We size every heat pump from your house. We look at the rooms, the insulation and the windows. And we ask how you really live in it. Sometimes that means a smaller unit than you expected. Sometimes it means a repair, not a new one. Either way, you'll get a straight answer and a free quote.</p>
        <p>That's why Nate Thompson started Heat Pumps HQ in {site.founded}. He'd spent years at a bigger heating company. He saw too many people sold systems bigger and dearer than their homes needed.</p>
        <p class="more"><a href="/about-us/">Read Nate's story</a></p>
      </div>
      <Img id="home-van" class="banner" />
    </div>
  </section>

  <section class="section warm">
    <div class="wrap">
      <div class="prose">
        <h2>Heat pumps made for Christchurch winters</h2>
        <p>Christchurch winters mean clear, frosty nights and cold mornings. It's worse out on the plains. A heat pump has to keep going when it's coldest outside. The outdoor unit has to defrost without fuss.</p>
        <p>That comes down to size and placement. The right size unit runs steady, not flat out. That keeps it quieter and cheaper to run. The outdoor unit goes on raised feet or a bracket, out of corners. The defrost water drains away and the neighbours won't hear it.</p>
        <p>Not sure what size you need? Start with <a href="/heat-pump-sizing/">heat pump sizing</a>.</p>
      </div>
      <Img id="home-outdoor" class="banner" />
    </div>
  </section>

  <section class="section warm">
    <div class="wrap">
      <h2>Heat pumps across Christchurch, Selwyn and Lyttelton</h2>
      <p class="lead">We work in every Christchurch suburb, plus Lyttelton and the Selwyn towns of Rolleston, Lincoln, Prebbleton and Tai Tapu.</p>
      <p class="areas"><strong>Popular areas:</strong> {areas.map(([n, href], i) => <>{i > 0 && ' · '}<a href={href}>{n}</a></>)}</p>
      <p class="more"><a href="/locations/">See all locations</a></p>
    </div>
  </section>

  <Faq items={faqs} heading="Common questions about heat pumps in Christchurch" />
  <CtaBand heading="Get a free heat pump quote in Christchurch" />
</Base>
<style>
  :global(.banner) { margin-top: 40px; width: 100%; aspect-ratio: 21/9 !important; object-fit: cover; }
  .three { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 980px) { .three { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .three { grid-template-columns: 1fr; } }
  .three :global(.card-img) { border-radius: 0; width: 100%; aspect-ratio: 3/2 !important; object-fit: cover; display: block; }
  .brand-split { display: grid; grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: center; }
  .brand-split h2 { margin-top: 0; }
  .brand-list { list-style: none; padding: 0; margin: 24px 0; }
  .brand-list li { position: relative; padding: 0 0 14px 22px; }
  .brand-list li::before { content: ''; position: absolute; left: 0; top: .65em; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  :global(.brand-photo) { width: 100%; aspect-ratio: 4/5 !important; object-fit: cover; border-radius: 12px; }
  @media (max-width: 900px) { .brand-split { grid-template-columns: 1fr; gap: 32px; } :global(.brand-photo) { aspect-ratio: 3/2 !important; } }
  .card h3 a { color: var(--ink); text-decoration: none; }
  .card h3 a:hover { color: var(--brand); }
  .areas a { font-weight: 600; }
  .card-check { font-size: .95rem; color: var(--ink-soft); }
  .card-go { margin-top: 12px; font-weight: 600; color: var(--link); }
  .card-go a { color: var(--link); text-decoration: none; }
  .card-go a:hover { text-decoration: underline; }
  .steps { padding-left: 1.4em; margin: 24px 0 0; }
  .steps li { padding: 0 0 14px 6px; }
</style>

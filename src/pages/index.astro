---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Hero from '../components/Hero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import AreaCards from '../components/AreaCards.astro';
import site from '../data/site.json';
import urls from '../data/urls.json';
const serviceCount = urls.filter((u) => u.type === 'service').length;



// The first seven cards are the core services in the Services menu
// (src/data/nav.json), in the same order; brand servicing and efficiency follow.
const services = [
  { img: 'home-install', h: 'Heat pump installation', href: '/heat-pump-installation-in-christchurch/', p: 'We fit wall and floor console heat pumps, sized from your rooms and installed tidy.',
    links: [['High wall heat pumps', '/high-wall-heat-pumps/'], ['Floor mounted heat pumps', '/floor-mounted-heat-pumps/'], ['Single room', '/single-room-heat-pump-installation/'], ['Installation cost', '/heat-pump-installation-cost-christchurch/']] },
  { img: 'home-ducted', h: 'Ducted heat pumps', href: '/ducted-heat-pumps-christchurch/', p: 'We plan and fit ducted systems with a vent in every room and nothing on the walls. Best planned early in a build.',
    links: [['Daikin ducted', '/daikin-ducted-heat-pumps-christchurch/'], ['Mitsubishi Electric ducted', '/mitsubishi-ducted-heat-pumps-christchurch/'], ['Zoning', '/heat-pump-zoning/'], ['Ducted heat pump cost', '/ducted-heat-pump-cost-christchurch/']] },
  { img: 'multi-hero', h: 'Multi-room heat pumps', href: '/multi-room-heat-pump-installation/', p: 'We fit several indoor units on one outdoor unit, so each room you use has its own heat and its own controller.',
    links: [['Single or multi room', '/single-multi-room/'], ['Ducted vs split', '/ducted-vs-split-heat-pumps-christchurch/'], ['Types of heat pumps', '/types-of-heat-pumps/'], ['Smart and Wi-Fi control', '/smart-heat-pump-systems/']] },
  { img: 'aircon-hero', h: 'Air conditioning', href: '/air-conditioning-installation-christchurch/', p: 'We install heat pumps that cool as well as heat, so one unit keeps the house comfortable on hot nor\'west days.',
    links: [['Dehumidifying', '/heat-pump-dehumidification/'], ['Energy efficient heat pumps', '/energy-efficient/'], ['Energy ratings', '/energy-star-heat-pumps/'], ['Brands compared', '/heat-pump-brands-comparison/']] },
  { img: 'home-service', h: 'Heat pump servicing', href: '/heat-pump-servicing/', p: 'We clean and check your heat pump once a year, so it runs cheaper and quieter and smells fresh.',
    links: [['Maintenance', '/maintenance-servicing/'], ['Seasonal tune-ups', '/heat-pump-seasonal-tune-ups/'], ['Winter preparation', '/winterisation-of-heat-pumps/'], ['Service plans', '/customised-heat-pump-service-plans/']] },
  { img: 'home-repair', h: 'Heat pump repairs', href: '/heat-pump-repair/', p: 'Not heating, leaking or showing an error code? We find the fault on any major brand and tell you if it\'s worth fixing.',
    links: [['Urgent repairs', '/emergency-heat-pump-repair/'], ['Troubleshooting', '/heat-pump-troubleshooting/'], ['Leak detection', '/leak-detection-repair/'], ['Parts replacement', '/heat-pump-parts-replacement/']] },
  { img: 'cleaning-hero', h: 'Heat pump cleaning', href: '/heat-pump-cleaning/', p: 'We deep clean behind the filters, taking the dust and mould off the coil and fan so the air comes out clean.',
    links: [['Deodorising', '/heat-pump-deodorising/'], ['Air quality checks', '/air-quality-testing/'], ['Allergies and asthma', '/allergy-asthma-solutions-heat-pumps/'], ['Heat pump covers', '/covers/']] },
  { img: 'mitsubishi-hero', h: 'Service by brand', href: '/heat-pump-services/', p: 'We fit Mitsubishi Electric, Daikin, Fujitsu and Toshiba, and service and repair those and Panasonic.',
    links: [['Mitsubishi Electric', '/mitsubishi-heat-pump-service-christchurch/'], ['Daikin', '/daikin-heat-pump-service-christchurch/'], ['Fujitsu', '/fujitsu-heat-pump-service-christchurch/'], ['Panasonic', '/panasonic-heat-pump-service-christchurch/']] },
  { img: 'upgrade-hero', h: 'Efficiency upgrades', href: '/heat-pump-efficiency-upgrades/', p: 'We swap old units for newer, more efficient ones and show you where your power is going.',
    links: [['Energy assessment', '/energy-efficiency-assessment/'], ['Power usage checks', '/energy-consumption-monitoring/'], ['Thermostat calibration', '/heat-pump-thermostat-calibration/'], ['Remote monitoring', '/remote-monitoring-and-diagnostics/']] },
];

const guides = [
  { img: 'boundary-hero', h: 'Heat pump boundary rules', href: '/heat-pump-boundary-rules-consent-nz/', p: 'The noise limits, when you need consent, and where the outdoor unit can go.' },
  { img: 'sizing-hero', h: 'What size heat pump do I need?', href: '/heat-pump-sizing/', p: 'How to work out the kW a room needs, so you don\'t pay for a unit that\'s too big.' },
  { img: 'instcost-hero', h: 'Installation cost', href: '/heat-pump-installation-cost-christchurch/', p: 'What makes up the price of an install, so you can compare quotes properly.' },
  { img: 'bestbrands-hero', h: 'Best heat pump brands', href: '/best-heat-pump-brands-christchurch/', p: 'How Mitsubishi Electric, Daikin, Fujitsu and Toshiba compare for Christchurch homes.' },
  { img: 'noise-hero', h: 'Noise problems', href: '/heat-pump-noise-problems-solutions/', p: 'Why a heat pump gets loud, and the fixes that quieten it.' },
  { img: 'dvs-hero', h: 'Ducted vs split', href: '/ducted-vs-split-heat-pumps-christchurch/', p: 'Which suits your house and budget, and what each one needs to fit.' },
];

const faqs = [
  { q: 'Which heat pump brands do you install?', a: 'Mitsubishi Electric, Daikin, Fujitsu and Toshiba. We service and fix those and Panasonic. We do most other brands sold in New Zealand too.' },
  { q: 'What areas do you cover?', a: 'All of Christchurch, and Lyttelton. Plus Selwyn towns like Rolleston, Lincoln and Prebbleton. See the <a href="/locations/">full list of locations</a>.' },
  { q: 'Do I need consent for a heat pump?', a: 'Usually not. Christchurch doesn\'t set a distance from the boundary. The District Plan controls the noise at the neighbour\'s property instead. Our <a href="/heat-pump-boundary-rules-consent-nz/">boundary rules guide</a> has the limits.' },
  { q: 'How often should a heat pump be serviced?', a: 'Once a year for most homes. Before winter is best. In between, clean the filters yourself every few weeks while it\'s working hard.' },
  { q: 'Are you insured?', a: 'Yes. We\'re fully insured. Every install comes with warranties on parts and labour.' },
];
---
<Base
  title="Heat Pumps Christchurch, Install & Repair"
  description="Heat pump installation, servicing and repairs in Christchurch. Mitsubishi, Daikin, Fujitsu and Toshiba, sized to your home with a fixed price upfront."
  image="home-hero"
  schema={[{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })) }]}>

  <Hero image="home-hero" h1="Heat pump installation, service and repairs in Christchurch"
        intro={`We fit, service and fix heat pumps across Christchurch, Selwyn and Lyttelton. Every unit is sized for your home, and you get a fixed price before we start. Locally owned since ${site.founded}.`} />

  <section class="section">
    <div class="wrap">
      <h2>Heat pump installation, servicing and repairs</h2>
      <p class="lead">From one bedroom unit to a ducted system for the whole house. We fit it, service it and fix it, anywhere in Christchurch.</p>
      <div class="grid three svc">
        {services.map((s) => (
          <article class="card">
            <a href={s.href} tabindex="-1" aria-hidden="true"><Img id={s.img} class="card-img" /></a>
            <div class="card-body">
              <h3><a href={s.href}>{s.h}</a></h3>
              <p>{s.p}</p>
              <ul class="card-links">{s.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
            </div>
          </article>
        ))}
      </div>
      <p class="more"><a href="/heat-pump-services/">See all {serviceCount} heat pump services</a></p>
    </div>
  </section>

  <section class="section warm">
    <div class="wrap">
      <div class="prose">
        <h2>Heat pumps sized for your home, not the biggest unit</h2>
        <p>We size every heat pump from your house. We look at the rooms, the insulation and the windows. And we ask how you really live in it. Sometimes that means a smaller unit than you expected. Sometimes it means a repair, not a new one. Either way, you'll get a straight answer and a fixed price up front.</p>
        <p>That's why Nate Thompson started Heat Pumps HQ in {site.founded}. He'd spent years at a bigger heating company. He saw too many people sold systems bigger and dearer than their homes needed.</p>
        <p class="more"><a href="/about-us/">More about Heat Pumps HQ</a></p>
      </div>
      <Img id="home-van" class="banner" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="prose">
        <h2>Heat pumps made for Christchurch winters</h2>
        <p>Christchurch winters mean clear, frosty nights and cold mornings. It's worse out on the plains. A heat pump has to keep going when it's coldest outside. The outdoor unit has to defrost without fuss.</p>
        <p>That comes down to size and placement. The right size unit runs steady, not flat out. That keeps it quieter and cheaper to run. The outdoor unit goes on raised feet or a bracket, out of corners. The defrost water drains away and the neighbours won't hear it.</p>
        <p>Not sure what size you need? Start with <a href="/heat-pump-sizing/">heat pump sizing</a>.</p>
      </div>
      <Img id="home-outdoor" class="banner" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Heat pump guides for Christchurch homes</h2>
      <p class="lead">What a heat pump costs, what size you need, which brand suits your house, and where the council lets the outdoor unit go.</p>
      <div class="grid three">
        {guides.map((g) => <a class="card" href={g.href}><Img id={g.img} class="card-img" /><div class="card-body"><h3>{g.h}</h3><p>{g.p}</p></div></a>)}
      </div>
      <p class="more"><a href="/how-heat-pumps-work/">Start with how a heat pump works</a></p>
    </div>
  </section>

  <section class="section warm">
    <div class="wrap">
      <h2>Heat pumps across Christchurch, Selwyn and Lyttelton</h2>
      <p class="lead">We work in every Christchurch suburb and in Lyttelton, plus the Selwyn towns of Rolleston, Lincoln, Prebbleton and Tai Tapu.</p>
      <AreaCards />
    </div>
  </section>

  <Faq items={faqs} heading="Common questions about heat pumps in Christchurch" />
  <CtaBand heading="Get a free heat pump quote in Christchurch" />
</Base>
<style>
  :global(.banner) { margin-top: 40px; width: 100%; aspect-ratio: 21/9 !important; object-fit: cover; }
  .three { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 980px) { .three { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .three { grid-template-columns: 1fr; } }
  .three :global(.card-img) { border-radius: 0; width: 100%; aspect-ratio: 3/2 !important; object-fit: cover; display: block; }
  .card h3 a { color: var(--ink); text-decoration: none; }
  .card h3 a:hover { color: var(--brand); }
  .card-links { list-style: none; padding: 0; margin: 16px 0 0; }
  .card-links li { display: flex; align-items: center; gap: 10px; padding: 7px 0; line-height: 1.35; border-top: 1px solid #eceff2; }
  .card-links li:last-child { padding-bottom: 0; }
  .card-links li::before { content: ''; flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--brand); }
  .card-links a { color: var(--link); text-decoration: none; font-weight: 500; font-size: .9rem; }
  .card-links a:hover { text-decoration: underline; }
</style>

---
// One route for every non-home page. Each page is a Markdown file in
// src/content/ named after its slug, so the URL is /<slug>/ exactly as on
// the old site.
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Hero from '../components/Hero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import SuburbMap from '../components/SuburbMap.astro';
import MoneyPage from '../components/MoneyPage.astro';
import SizeCalc from '../components/SizeCalc.astro';
import site from '../data/site.json';
import urls from '../data/urls.json';
import nav from '../data/nav.json';
import images from '../data/images.json';

export async function getStaticPaths() {
  const files = import.meta.glob('../content/*.md', { eager: true });
  const known = new Set((await import('../data/urls.json')).default.map((u) => u.slug));
  return Object.entries(files).map(([path, mod]) => {
    const slug = path.split('/').pop().replace(/\.md$/, '');
    if (!known.has(slug)) throw new Error(`${slug} is not one of the old site's URLs`);
    return { params: { slug }, props: { mod } };
  });
}

const { mod } = Astro.props;
const fm = mod.frontmatter;
const suburbCount = urls.filter((u) => u.type === 'suburb').length;
// The gallery photos go inside the article, between sections: the first
// after the opening section, the second about two thirds of the way down.
const sections = (await mod.compiledContent()).split(/(?=<h2[\s>])/).filter((h) => h.trim());
const gallery = fm.gallery ?? [];
const slots = new Map();
const bandImages = fm.bandImages ?? [];
if (!bandImages.length && gallery[0] && sections.length > 2) slots.set(1, gallery[0]);
if (!bandImages.length && gallery[1] && sections.length > 3) slots.set(Math.max(2, Math.round(sections.length * 2 / 3)), gallery[1]);
const leftover = gallery.filter((id) => ![...slots.values()].includes(id));
// Each H2 section of the article becomes its own band, alternating white and
// light blue. A gallery photo slotted before section i closes the band above it.
// linkCards: a list of "[Label](/page/): what we do" lines becomes a grid of
// cards, each with the linked page's hero photo.
const allPages = import.meta.glob('../content/*.md', { eager: true });
const heroOf = (href) => allPages[`../content/${href.replace(/\//g, '')}.md`]?.frontmatter?.hero;
const cardList = (html) => html.replace(/<ul>([\s\S]*?)<\/ul>/g, (ul, inner) => {
  const items = [...inner.matchAll(/<li><a href="(\/[^"]+)">([^<]+)<\/a>:\s*([\s\S]*?)<\/li>/g)];
  if (!items.length) return ul;
  return `<div class="link-cards">${items.map(([, href, label, text]) => {
    const id = heroOf(href); const img = id && images[id];
    return `<a class="card link-card" href="${href}">${img ? `<img src="/images/${id}.webp" alt="${img.alt}" loading="lazy" decoding="async" width="${img.aspect.split('x')[0] * 100}" height="${img.aspect.split('x')[1] * 100}">` : ''}<div class="card-body"><h3>${label}</h3><p>${text}</p></div></a>`;
  }).join('')}</div>`;
});
const bands = sections.map((html, i) => ({ html: fm.linkCards ? cardList(html) : html, photo: slots.get(i + 1) }));
const { slug } = Astro.params;
const entry = urls.find((u) => u.slug === slug);
const type = entry.type;
const url = `${site.domain}/${slug}/`;
// Breadcrumbs follow the main menu: the parent is the menu section the page
// sits in (Installs, Services, Guides), or Locations for suburbs. The last
// crumb is the page's short menu label, or the suburb name.
const path = `/${slug}/`;
const section = [nav.installs, nav.services, nav.guides].find((m) => m.groups.some((g) => g.links.some(([, href]) => href === path)));
// Install pages sit under Services in the menu, so they crumb to Services.
const parentOf = section === nav.installs ? nav.services : section;
const isInstallHub = path === nav.installs.href;
const crumbParent = isInstallHub ? { label: nav.services.label, href: nav.services.href }
  : type === 'suburb' ? { label: 'Locations', href: '/locations/' }
  : parentOf && parentOf.href !== path ? { label: parentOf.label, href: parentOf.href } : undefined;
const crumbName = (isInstallHub ? 'Installation options' : undefined) ?? fm.suburb ?? section?.groups.flatMap((g) => g.links).find(([, href]) => href === path)?.[0]
  ?? (type === 'hub' ? [nav.installs, nav.services, nav.guides].find((m) => m.href === path)?.label : undefined)
  ?? site.nav.find((n) => n.href === path)?.label ?? fm.title;
const crumbs = [{ label: 'Home', href: '/' }, ...(crumbParent ? [crumbParent] : []), { label: crumbName, href: path }];

// Brand tiles: what we do with each brand and where its pages are.
const brandPages = {
  'Mitsubishi Electric': [['Service and repair', '/mitsubishi-heat-pump-service-christchurch/'], ['Ducted systems', '/mitsubishi-ducted-heat-pumps-christchurch/']],
  'Daikin': [['Service and repair', '/daikin-heat-pump-service-christchurch/'], ['Ducted systems', '/daikin-ducted-heat-pumps-christchurch/']],
  'Fujitsu': [['Service and repair', '/fujitsu-heat-pump-service-christchurch/']],
  'Toshiba': [['Service and repair', '/toshiba-heat-pump-service-christchurch/'], ['How the brands compare', '/heat-pump-brands-comparison/']],
  'Panasonic': [['Service and repair', '/panasonic-heat-pump-service-christchurch/']],
};
const brandNotes = {};
const brandTiles = site.brandsServiced.map((name) => ({ name, installed: site.brandsInstalled.includes(name), note: brandNotes[name], links: brandPages[name] ?? [] }));

const schema = [];
schema.push({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: `${site.domain}${c.href}` })),
});
// Suburb pages name the place fully; Selwyn towns sit in Selwyn District.
const selwyn = ['Rolleston', 'Lincoln', 'Prebbleton', 'Tai Tapu'];
// Service pages cover the whole service area, the same as the business.
const place = fm.suburb
  ? {
      '@type': 'Place', name: `${fm.suburb}, ${selwyn.includes(fm.suburb) ? 'Selwyn District' : 'Christchurch'}, New Zealand`,
      containedInPlace: selwyn.includes(fm.suburb) ? { '@type': 'AdministrativeArea', name: 'Selwyn District' } : { '@type': 'City', name: 'Christchurch' },
    }
  : [{ '@type': 'City', name: 'Christchurch' }, { '@type': 'AdministrativeArea', name: 'Selwyn District' }, { '@type': 'Place', name: 'Lyttelton' }];
// The published from-price goes only on pages for a standard single install
// (CLAUDE.md lists every place the price appears).
const fromPricePages = ['heat-pump-installation-in-christchurch', 'single-room-heat-pump-installation', 'high-wall-heat-pumps'];
const fromPrice = fromPricePages.includes(slug) ? {
  offers: { '@type': 'Offer', priceSpecification: { '@type': 'PriceSpecification', minPrice: Number(site.installFrom.replace(/[^0-9]/g, '')), priceCurrency: 'NZD' } },
} : {};
const heroUrl = fm.hero ? `${site.domain}/images/${fm.hero}.jpg` : undefined;
if (type === 'service' || type === 'suburb') {
  schema.push({
    '@context': 'https://schema.org', '@type': 'Service',
    name: fm.serviceName ?? fm.h1, serviceType: fm.serviceName ?? fm.h1, url,
    description: fm.intro,
    provider: { '@id': `${site.domain}/#business` },
    areaServed: place,
    ...fromPrice,
    ...(heroUrl && { image: heroUrl }),
  });
}
if (type === 'guide') {
  schema.push({
    '@context': 'https://schema.org', '@type': 'Article',
    headline: fm.h1, url, image: heroUrl,
    datePublished: fm.updated, dateModified: fm.updated,
    author: { '@type': 'Person', '@id': `${site.domain}/#founder`, name: site.owner, url: `${site.domain}/about-us/` },
    publisher: { '@id': `${site.domain}/#business` },
    mainEntityOfPage: url,
  });
}
if (type === 'about' || type === 'contact') {
  schema.push({ '@context': 'https://schema.org', '@type': type === 'about' ? 'AboutPage' : 'ContactPage', url, name: fm.title, about: { '@id': `${site.domain}/#business` } });
}
if (fm.faqs?.length) {
  schema.push({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: fm.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
  });
}
---
<Base title={fm.title} description={fm.description} schema={schema} image={fm.hero}>
  <Hero image={fm.hero} h1={fm.h1} intro={fm.intro} suburb={fm.suburb ?? ''}
        meta={type === 'guide' && fm.updated ? `Updated ${new Date(fm.updated).toLocaleDateString('en-NZ', { day: 'numeric', month: 'long', year: 'numeric' })}` : undefined}>
    <nav slot="crumbs" class="crumbs-hero" aria-label="Breadcrumb">
      {crumbs.map((c, i) => i < crumbs.length - 1
        ? <><a href={c.href}>{c.label}</a> / </>
        : <span aria-current="page">{c.label}</span>)}
    </nav>
  </Hero>
  {fm.calculator && <SizeCalc />}
  {fm.design === 'money' && <MoneyPage sections={sections} fm={fm} heroOf={heroOf} />}
  {fm.design !== 'money' && bands.map((b, i) => (
    <>
    <section class={`band ${i % 2 ? 'band-tint' : ''}`}>
      {bandImages[i] ? (
        <div class={`wrap band-split ${i % 2 ? '' : 'flip'} ${fm.bandLayout === 'areas' ? 'areas-split' : ''}`}>
          <figure class="band-photo"><Img id={bandImages[i]} /></figure>
          <div class="prose"><Fragment set:html={b.html} /></div>
        </div>
      ) : (
        <div class="wrap prose">
          <Fragment set:html={b.html} />
          {b.photo && <figure class="inline-photo"><Img id={b.photo} /></figure>}
        </div>
      )}
    </section>
    {i === 1 && bands.length > 3 && !['legal', 'contact'].includes(type) && (
      <section class="mid-cta">
        <div class="wrap mid-cta-in">
          <p><strong>Get a free quote{fm.suburb ? ` in ${fm.suburb}` : ''}.</strong> Installs, servicing and repairs on all major brands.</p>
          <div class="mid-cta-btns">
            <a class="btn btn-primary" href={site.phoneHref}>Call {site.phone}</a>
            <a class="btn btn-ghost" href="#quote">Request a quote</a>
          </div>
        </div>
      </section>
    )}
    </>
  ))}
  {fm.suburbMap && <SuburbMap heading={fm.suburbMap.heading} lead={fm.suburbMap.lead} />}
  {fm.design !== 'money' && fm.steps?.length && (
    <section class="section tint">
      <div class="wrap">
        <h2>{fm.stepsHeading ?? 'How we work at Heat Pumps HQ'}</h2>
        <div class="grid steps">
          {fm.steps.map((st, i) => (
            <div class="card step"><div class="card-body"><p class="step-n">{i + 1}</p><h3>{st.h}</h3><p set:html={st.p} /></div></div>
          ))}
        </div>
      </div>
    </section>
  )}
  {fm.brands && (
    <section class:list={["section", { warm: fm.design === 'money' }]}>
      <div class="wrap">
        <h2>{fm.brandsHeading ?? 'Heat pump brands we fit and service'}</h2>
        <p class="lead">We install four brands and compare their models for your rooms, then suggest the one that fits, not whatever's in stock.</p>
        <div class="brands">
          {brandTiles.map((t) => (
            <div class="brand">
              <p class="brand-tag">{t.installed ? 'Install and service' : 'Service and repair'}</p>
              <h3>{t.name}</h3>
              {t.note && <p class="brand-note">{t.note}</p>}
              {t.links.length > 0 && <ul>{t.links.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>}
            </div>
          ))}
          <div class="brand">
            <p class="brand-tag">Service and repair</p>
            <h3>Other brands</h3>
            <p class="brand-note">Most other split and ducted heat pumps sold in New Zealand.</p>
            <ul><li><a href="/maintenance-servicing/">Heat pump servicing</a></li><li><a href="/heat-pump-repair/">Heat pump repairs</a></li></ul>
          </div>
        </div>
      </div>
    </section>
  )}
  {fm.areas && (
    <section class="section tint">
      <div class="wrap">
        <h2>{fm.areasHeading}</h2>
        <p class="lead">{fm.areasLead}</p>
        <p class="more"><a href="/locations/">See all {suburbCount} suburbs and towns we cover</a></p>
      </div>
    </section>
  )}
  {fm.areaPhoto && (
    <section class="section tint">
      <div class="wrap">
        <h2>Where Heat Pumps HQ works</h2>
        <p class="lead">All of Christchurch and Lyttelton, plus Rolleston, Lincoln, Prebbleton and Tai Tapu in Selwyn. Find your suburb under <a href="/locations/">locations</a>.</p>
        <figure class="inline-photo"><Img id={fm.areaPhoto} /></figure>
      </div>
    </section>
  )}
  {leftover.length > 0 && (
    <section class="section tint">
      <div class="wrap grid grid-2">{leftover.map((id) => <Img id={id} />)}</div>
    </section>
  )}
  {fm.faqs?.length && <Faq items={fm.faqs} heading={fm.faqHeading} split={fm.design === 'money'} />}
  {fm.related?.length && (
    <section class="section">
      <div class="wrap">
        <h2>{fm.relatedHeading ?? 'Related heat pump pages'}</h2>
        <div class="grid grid-3">
          {fm.related.map((r) => (
            <a class="card rel-card" href={r.href}>
              {heroOf(r.href) && <Img id={heroOf(r.href)} class="rel-img" />}
              <div class="card-body"><h3>{r.label}</h3><p>{r.text}</p><span class="rel-go">{r.cta ?? (urls.find((u) => u.path === r.href)?.type === 'guide' ? `Read the ${r.label.toLowerCase().replace(/ guide$/, '')} guide` : `See ${r.label.toLowerCase()}`)} →</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  <CtaBand heading={fm.ctaHeading} />
</Base>
<style>
  .rel-card { background: var(--brand-tint); box-shadow: none; display: flex; flex-direction: column; }
  .rel-card:hover { background: #dcebf4; }
  .rel-card :global(.rel-img) { display: block; width: 100%; aspect-ratio: 16/9 !important; object-fit: cover; border-radius: 0; }
  .rel-card h3 { color: var(--ink); }
  .rel-card .card-body { display: flex; flex-direction: column; flex: 1; }
  .rel-card p { flex: 1; }
  .rel-go { margin-top: 18px; color: var(--link); font-weight: 700; text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }
  :global(.link-cards) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin: 28px 0 8px; }
  :global(.prose .link-card) { text-decoration: none; color: inherit; display: flex; flex-direction: column; }
  :global(.link-card img) { display: block; width: 100%; aspect-ratio: 3/2; object-fit: cover; margin: 0; border-radius: 0; }
  :global(.prose .link-card h3) { margin: 0 0 8px; font-size: 1.15rem; color: var(--link); }
  :global(.prose .link-card p) { margin: 0; line-height: 1.5; }
  :global(.prose .link-card:hover h3) { text-decoration: underline; }
  @media (max-width: 980px) { :global(.link-cards) { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { :global(.link-cards) { grid-template-columns: 1fr; } }
  .steps { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr; } }
  .step-n { font-size: 2.4rem; font-weight: 800; color: var(--brand); line-height: 1; margin: 0 0 .3em; }
  .step p { color: var(--ink-soft); }
  .brands { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 24px 0 0; }
  @media (max-width: 900px) { .brands { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .brands { grid-template-columns: 1fr; } }
  .brand { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow); padding: 22px 24px; }
  .brand h3 { margin: 0 0 4px; font-size: 1.3rem; }
  .brand-tag { display: inline-block; margin: 0 0 10px; padding: 3px 10px; border-radius: 999px; background: var(--brand-tint); color: var(--brand-ink); font-size: .8rem; font-weight: 700; letter-spacing: .02em; }
  .brand-note { color: var(--ink-soft); font-size: .95rem; margin: 0 0 8px; }
  .brand ul { list-style: none; padding: 0; margin: 10px 0 0; }
  .brand li { display: flex; align-items: center; gap: 10px; padding: 6px 0; border-top: 1px solid #eceff2; font-size: .95rem; }
  .brand li::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--brand); flex: none; }
</style>
